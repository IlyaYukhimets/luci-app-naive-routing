#!/bin/sh /etc/rc.common
# naiveproxy client managed by luci-app-naive-routing.
# The client configuration is generated from UCI on every start, so the UCI
# file is the single source of truth.
#
# START=99: after networking and firewall.

START=99
USE_PROCD=1

PROG=/usr/bin/naive
DEF_CONF=/var/etc/naive/config.json
LIBEXEC=/usr/libexec/naive-routing

make_config() {
	local proxy redir socks conc conf
	proxy=$(uci -q get naive_routing.settings.proxy_url)
	if [ -z "$proxy" ]; then
		echo "naive-routing: option 'proxy_url' is not set" >&2
		return 1
	fi
	redir=$(uci -q get naive_routing.settings.redir_port); [ -n "$redir" ] || redir=11090
	socks=$(uci -q get naive_routing.settings.socks_port); [ -n "$socks" ] || socks=11081
	conc=$(uci -q get naive_routing.settings.concurrency);  [ -n "$conc" ]  || conc=3
	conf=$(uci -q get naive_routing.settings.naive_config);  [ -n "$conf" ]  || conf=$DEF_CONF

	mkdir -p "$(dirname "$conf")"
	cat > "$conf" <<EOF
{
  "listen": [
    "redir://0.0.0.0:${redir}",
    "socks://127.0.0.1:${socks}"
  ],
  "proxy": "${proxy}",
  "insecure-concurrency": ${conc}
}
EOF
	echo "$conf"
}

opt() {
	uci -q get "naive_routing.settings.$1" || uci -q get "naive_routing.$1"
}

# Minutes until the next occurrence of HH:MM, used to schedule the list updaters
# without depending on cron.
minutes_until() {
	local now target
	now=$(( $(date +%H | sed "s/^0//") * 60 + $(date +%M | sed "s/^0//") ))
	target=$(( $1 * 60 + $2 ))
	local delta=$(( (target - now + 1440) % 1440 ))
	[ "$delta" -eq 0 ] && delta=1440
	echo "$delta"
}

start_service() {
	[ -x "$PROG" ] || { echo "naive-routing: $PROG not found" >&2; return 1; }
	conf=$(make_config) || return 1

	procd_open_instance
	procd_set_param command "$PROG" "$conf"
	procd_set_param user root
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1048576 1048576"
	procd_close_instance

	# Watchdog: keeps the nftables interception in sync with the real exit IP.
	# Scheduled here rather than through cron so the package has no dependency
	# on the crontab and survives a fresh install without manual setup.
	local wd int
	wd=$(opt watchdog); [ -n "$wd" ] || wd=1
	int=$(opt watchdog_interval); [ -n "$int" ] || int=60
	if [ "$wd" = "1" ]; then
		procd_open_instance watchdog
		procd_set_param command /bin/sh -c "while :; do $LIBEXEC/health.sh >/dev/null 2>&1; sleep $int; done"
		procd_set_param respawn 3600 5 5
		procd_close_instance
	fi

	# Nightly refresh of the address and domain lists.
	local uh um upd
	upd=$(opt update_lists); [ -n "$upd" ] || upd=1
	uh=$(opt update_hour); [ -n "$uh" ] || uh=3
	um=$(opt update_min);  [ -n "$um" ] || um=30
	if [ "$upd" = "1" ]; then
		local wait_min
		wait_min=$(minutes_until "$uh" "$um")
		procd_open_instance lists
		procd_set_param command /bin/sh -c "sleep $((wait_min * 60)); while :; do \
			$LIBEXEC/update-ips.sh >/dev/null 2>&1; \
			$LIBEXEC/update-domains.sh >/dev/null 2>&1; \
			sleep 86400; done"
		procd_set_param respawn 3600 5 5
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger "naive_routing"
}

reload_service() {
	stop
	start
}
